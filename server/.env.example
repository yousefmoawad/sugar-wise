# Server
PORT=2222
NODE_ENV=development

# MongoDB
MONGO_URI=
# Optional fallback if the primary connection cannot be reached:
# MONGO_URI_LOCAL=

# Authentication: replace with a strong, unique random value
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Optional email delivery settings
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
